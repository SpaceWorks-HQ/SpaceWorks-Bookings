generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries use DATABASE_URL, which may be a transaction pooler
  // (for example Supabase Supavisor :6543 with ?pgbouncer=true). Migrations need a
  // direct or session-mode connection, so the Prisma CLI uses DIRECT_URL.
  // scripts/prisma.mjs defaults DIRECT_URL to DATABASE_URL when it is unset.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Platform ────────────────────────────────────────────────────────────────

/// Makerspace staff roles (lib/permissionRoles.ts maps them to capabilities). Customers are not staff. BOOKINGS_MANAGER
/// is the top role; there is no owner, space manager or treasurer role (docs/DECISIONS.md, 2026-10-24).
enum TeamRole {
  BOOKINGS_MANAGER
  FRONT_DESK
  VIEWER
  /// Repairs only: the issues they are asked to fix (lib/repairs).
  TECHNICIAN
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  /// User-selected profile image. Provider images remain in `image` as a fallback.
  profileImageUrl    String?
  /// Bcrypt hash for email + password sign-in. Null until the person sets a password.
  passwordHash       String?
  /// Incremented to invalidate all issued JWT sessions after account recovery.
  sessionVersion     Int       @default(0)
  /// AES-GCM encrypted TOTP seed. Never expose or log this value.
  mfaSecretEncrypted String?
  mfaEnabledAt       DateTime?
  recoveryCodeHashes String[]  @default([])
  /// Platform operators. SUPER_ADMIN_EMAIL bootstraps the first one.
  isSuperAdmin       Boolean   @default(false)
  createdAt          DateTime  @default(now())

  knownDevices       KnownDevice[]
  teamMembers        TeamMember[]
  teamInvitesCreated TeamInvite[]       @relation("TeamInviteCreatedBy")
  teamInvitesUsed    TeamInvite[]       @relation("TeamInviteUsedBy")
  auditEvents        AuditEvent[]
  makerspaceReviews  MakerspaceReview[]
  bookings           Booking[]
  calendarFeeds      CalendarFeed[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Tenants ─────────────────────────────────────────────────────────────────

enum MakerspaceStatus {
  PENDING_REVIEW
  CHANGES_REQUESTED
  ACTIVE
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum MakerspaceSource {
  SELF_SIGNUP
  SUPERADMIN
}

enum MakerspaceVisibility {
  UNLISTED
  PUBLIC
}

enum MakerspaceReviewAction {
  SUBMITTED
  RESUBMITTED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  REACTIVATED
  ARCHIVED
  CREATED
}

/// A tenant. Only ACTIVE makerspaces take bookings; see makerspaceAllows in lib/permissionRoles.ts.
model Makerspace {
  id                          String               @id @default(cuid())
  name                        String
  slug                        String               @unique
  description                 String               @default("")
  logoUrl                     String?
  /// Makerspace accent for its public pages (validated #RRGGBB).
  accentColor                 String?
  status                      MakerspaceStatus     @default(PENDING_REVIEW)
  source                      MakerspaceSource     @default(SELF_SIGNUP)
  /// Free-text kind, e.g. "Club", "Association", "Student society".
  kind                        String               @default("")
  contactEmail                String?
  contactPhone                String?
  addressLine                 String?
  city                        String?
  /// Indian state/UT code (two letters, e.g. "KL"); also the GST supplier state.
  stateCode                   String?
  postalCode                  String?
  country                     String               @default("IN")
  website                     String?
  /// Month (1–12) the makerspace's financial year starts. India: April.
  financialYearStartMonth     Int                  @default(4)
  timezone                    String               @default("Asia/Kolkata")
  currency                    String               @default("INR")
  /// Set by the platform super-admin; null means the instance default.
  managerLimit                Int?
  /// Maker-checker for offline payments: the confirmer must differ from the recorder.
  offlineConfirmationRequired Boolean              @default(false)
  /// PUBLIC makerspaces are listed at /makerspaces and take applications from anyone.
  visibility                  MakerspaceVisibility @default(UNLISTED)
  /// Number formatting override, e.g. "en-IN"; null uses the currency's own locale.
  locale                      String?
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  teamMembers      TeamMember[]
  teamInvites      TeamInvite[]
  reviews          MakerspaceReview[]
  assets           Asset[]
  auditEvents      AuditEvent[]
  paymentSettings  MakerspacePaymentSettings?
  taxSettings      MakerspaceTaxSettings?
  payments         Payment[]
  refunds          Refund[]
  taxDocuments     TaxDocument[]
  documentCounters DocumentCounter[]
  emailSettings    MakerspaceEmailSettings?
  chatChannels     ChatChannel[]
  bookingSettings  MakerspaceBookingSettings?
  spaces           Space[]
  spacePhotos      SpacePhoto[]
  openingHours     OpeningHours[]
  hoursExceptions  HoursException[]
  blackouts        Blackout[]
  peakRules        PeakRule[]
  addOns           AddOn[]
  refundTiers      RefundTier[]
  members          MakerspaceMember[]
  bookings         Booking[]
  bookingEvents    BookingEvent[]
  calendarFeeds    CalendarFeed[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  technicians      Technician[]
  spaceIssues      SpaceIssue[]
  financeEntries   FinanceEntry[]

  @@index([status, createdAt])
  @@index([visibility, status])
}

/// Append-only history of a makerspace's application and lifecycle decisions.
model MakerspaceReview {
  id                  String                 @id @default(cuid())
  makerspaceId        String
  action              MakerspaceReviewAction
  actorUserId         String?
  /// Required for REJECTED and CHANGES_REQUESTED; shown to the applicant.
  reason              String?
  /// The application as submitted (name, contact, address, purpose…) at SUBMITTED/RESUBMITTED.
  applicationSnapshot Json?
  createdAt           DateTime               @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  actor      User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([makerspaceId, createdAt])
  @@index([action, createdAt])
}

model TeamInvite {
  id              String    @id @default(cuid())
  makerspaceId    String
  token           String    @unique
  role            TeamRole  @default(VIEWER)
  createdByUserId String?
  /// Set when the platform super-admin creates a makerspace for someone: only this email may accept.
  email           String?
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?
  usedAt          DateTime?
  usedByUserId    String?

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("TeamInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  usedBy     User?      @relation("TeamInviteUsedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([makerspaceId])
  @@index([makerspaceId, createdAt])
  @@index([usedAt])
}

/// A person on a makerspace's team (staff). Customers who book are not team members.
model TeamMember {
  id           String   @id @default(cuid())
  userId       String
  makerspaceId String
  role         TeamRole
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, makerspaceId])
  @@index([makerspaceId])
}

// ─── Operations ──────────────────────────────────────────────────────────────

model AuditEvent {
  id           String   @id @default(cuid())
  action       String
  actorUserId  String?
  makerspaceId String?
  targetType   String?
  targetId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  actor      User?       @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  makerspace Makerspace? @relation(fields: [makerspaceId], references: [id], onDelete: SetNull)

  @@index([makerspaceId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([action, createdAt])
}

model OutboxMessage {
  id          String       @id @default(cuid())
  kind        String
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now())
  lockedAt    DateTime?
  sentAt      DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())

  @@index([status, availableAt])
  @@index([createdAt])
}

/// One-row operational state for scheduled work, separate from the human audit trail.
model OperationalHeartbeat {
  key             String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastSent        Int       @default(0)
  lastFailed      Int       @default(0)
  lastError       String?
  updatedAt       DateTime  @updatedAt
}

/// Instance-wide, super-admin-managed controls. The singleton row is created on first change.
model InstanceSetting {
  id                          String    @id
  allowNewUserSignups         Boolean   @default(true)
  /// Self-service makerspace applications (/start). Super-admins can always create makerspaces.
  allowMakerspaceApplications Boolean   @default(true)
  emailFrom                   String?
  smtpService                 String?
  smtpHost                    String?
  smtpPort                    Int?
  smtpSecure                  Boolean   @default(false)
  smtpUser                    String?
  smtpPasswordEncrypted       String?
  smtpAllowUnauthenticated    Boolean   @default(false)
  backupProvider              String?
  backupLastSuccessAt         DateTime?
  backupRetentionDays         Int?
  updatedAt                   DateTime  @updatedAt
}

/// Stored files (Silo/S3/R2) for per-makerspace storage accounting, or the database fallback.
model Asset {
  id           String   @id @default(cuid())
  makerspaceId String?
  /// Provider-specific object key (or path).
  key          String   @unique
  publicUrl    String?
  contentType  String?
  byteSize     BigInt?
  provider     String   @default("unknown")
  fileData     Bytes?
  createdAt    DateTime @default(now())

  makerspace Makerspace? @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@index([makerspaceId])
  @@index([createdAt])
  @@index([provider])
}

// ── Payments and tax documents (P7) ─────────────────────────────────────────

enum GatewayProvider {
  NONE
  RAZORPAY
  STRIPE
}

enum PaymentProvider {
  RAZORPAY
  STRIPE
  OFFLINE
}

enum PaymentStatus {
  PENDING
  AWAITING_CONFIRMATION
  PAID
  WAIVED
  FAILED
  CANCELLED
}

enum PaymentLineKind {
  BOOKING
  ADD_ON
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

/// What a booking payment pays for.
enum PaymentPurpose {
  FULL
  DEPOSIT
  BALANCE
  DIFFERENCE
}

/// Why a refund was made (docs/PAYMENTS.md "Refunds").
enum RefundKind {
  POLICY
  VENUE
  MANUAL
  RESCHEDULE
  DUPLICATE
  LATE_CAPTURE
  EXTERNAL
}

enum TaxMode {
  GST
  SIMPLE
  NONE
}

enum GstScheme {
  REGULAR
  COMPOSITION
}

/// How a GST-registered makerspace treats plans priced in other currencies.
enum ForeignCurrencyTax {
  EXPORT_LUT
  NO_TAX
}

enum TaxDocumentKind {
  RECEIPT
  TAX_INVOICE
  BILL_OF_SUPPLY
  CREDIT_NOTE
}

/// The makerspace's payment gateway. Secrets are AES-GCM encrypted with PAYMENT_SECRETS_KEY.
model MakerspacePaymentSettings {
  makerspaceId           String          @id
  provider               GatewayProvider @default(NONE)
  /// Razorpay key id (public). Stripe needs only the secret key.
  keyId                  String?
  secretEncrypted        String?
  webhookSecretEncrypted String?
  /// Unguessable code in the webhook URL that identifies the makerspace.
  webhookPublicCode      String          @unique
  testMode               Boolean         @default(true)
  verifiedAt             DateTime?
  upiVpa                 String?
  upiPayeeName           String?
  offlineInstructions    String          @default("")
  updatedAt              DateTime        @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
}

model MakerspaceTaxSettings {
  makerspaceId       String             @id
  mode               TaxMode            @default(NONE)
  scheme             GstScheme          @default(REGULAR)
  gstin              String?
  legalName          String?
  address            String?
  /// Supplier state code; also the place-of-supply fallback.
  stateCode          String?
  sacCode            String             @default("997212")
  rateBps            Int                @default(1800)
  inclusive          Boolean            @default(true)
  exempt             Boolean            @default(false)
  foreignCurrencyTax ForeignCurrencyTax @default(NO_TAX)
  lutNumber          String?
  /// Name printed for SIMPLE mode, e.g. "VAT".
  simpleTaxName      String             @default("Tax")
  /// 0–4 uppercase letters or digits before every document number.
  receiptPrefix      String             @default("")
  updatedAt          DateTime           @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
}

model Payment {
  id                String          @id @default(cuid())
  makerspaceId      String
  /// The booking this payment is for (a trigger checks it belongs to the same makerspace).
  bookingId         String?
  purpose           PaymentPurpose?
  /// Who paid, as typed at the time (also the tax document's recipient).
  customerName      String
  customerEmail     String
  /// Indian state/UT code of the customer: the GST place of supply.
  customerStateCode String?
  customerGstin     String?
  status            PaymentStatus   @default(PENDING)
  provider          PaymentProvider
  /// upi, card, netbanking, wallet, cash, bank_transfer, cheque…
  method            String?
  currency          String
  amountMinor       Int
  /// Razorpay order id or Stripe Checkout Session id.
  gatewayOrderId    String?
  /// Razorpay payment id or Stripe PaymentIntent id.
  gatewayPaymentId  String?
  settlementId      String?
  utr               String?
  reference         String?
  note              String          @default("")
  paidAt            DateTime?
  recordedById      String?
  confirmedById     String?
  /// Set when a captured payment needs a manager's attention (late, mismatched, duplicate).
  flaggedAt         DateTime?
  flagReason        String?
  /// The tax document waits for review (amount mismatch).
  documentHeld      Boolean         @default(false)
  capturedMinor     Int?
  /// Tax configuration frozen when the payment was created.
  taxSnapshot       Json
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  makerspace Makerspace    @relation(fields: [makerspaceId], references: [id], onDelete: Restrict)
  booking    Booking?      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  lines      PaymentLine[]
  refunds    Refund[]
  documents  TaxDocument[]

  @@unique([makerspaceId, id])
  @@unique([provider, gatewayOrderId])
  @@index([makerspaceId, status, createdAt])
  @@index([makerspaceId, paidAt])
  @@index([makerspaceId, bookingId])
}

model PaymentLine {
  id            String          @id @default(cuid())
  makerspaceId  String
  paymentId     String
  kind          PaymentLineKind
  description   String
  currency      String
  amountMinor   Int
  taxableMinor  Int
  cgstMinor     Int             @default(0)
  sgstMinor     Int             @default(0)
  igstMinor     Int             @default(0)
  otherTaxMinor Int             @default(0)

  payment Payment @relation(fields: [makerspaceId, paymentId], references: [makerspaceId, id], onDelete: Restrict)

  @@index([paymentId])
}

/// Webhook idempotency: a provider event is applied once.
model ProcessedWebhookEvent {
  provider     PaymentProvider
  eventId      String
  makerspaceId String
  receivedAt   DateTime        @default(now())

  @@id([provider, eventId])
  @@index([makerspaceId, receivedAt])
}

model Refund {
  id              String       @id @default(cuid())
  makerspaceId    String
  paymentId       String
  status          RefundStatus @default(PENDING)
  currency        String
  amountMinor     Int
  reason          String       @default("")
  gatewayRefundId String?      @unique
  createdById     String?
  failureReason   String?
  createdAt       DateTime     @default(now())
  processedAt     DateTime?
  /// When the scheduler last asked the gateway about this pending refund.
  lastCheckedAt   DateTime?
  kind            RefundKind   @default(MANUAL)
  /// Refund rows split from one booking refund share a group (lib/bookings/money/allocate.ts).
  refundGroupId   String?
  /// A retry of a failed refund is a new row pointing at it.
  retryOfId       String?      @unique
  /// The money goes back outside the gateway: a person hands it back and records method and reference.
  offlineRequired Boolean      @default(false)
  method          String?
  reference       String?
  flaggedAt       DateTime?
  flagReason      String?
  /// Claimed for sending to the gateway (lib/bookings/money/send.ts); null until then.
  sentAt          DateTime?

  makerspace Makerspace   @relation(fields: [makerspaceId], references: [id], onDelete: Restrict)
  payment    Payment      @relation(fields: [makerspaceId, paymentId], references: [makerspaceId, id], onDelete: Restrict)
  document   TaxDocument?
  retryOf    Refund?      @relation("RefundRetry", fields: [retryOfId], references: [id], onDelete: Restrict)
  retry      Refund?      @relation("RefundRetry")

  @@unique([makerspaceId, id])
  @@index([makerspaceId, createdAt])
  @@index([paymentId])
  @@index([status, sentAt])
}

/// A refund the provider reported that matches none of ours (made in the provider's dashboard). The reconcile job
/// records it as an EXTERNAL refund after a grace period, so our own refunds' webhooks can arrive first.
model GatewayRefundNotice {
  provider         PaymentProvider
  gatewayRefundId  String
  makerspaceId     String
  gatewayPaymentId String?
  amountMinor      Int
  receivedAt       DateTime        @default(now())
  resolvedAt       DateTime?

  @@id([provider, gatewayRefundId])
  @@index([resolvedAt, receivedAt])
}

/// Receipts, tax invoices, bills of supply and credit notes. The PDF is rendered from `snapshot`.
model TaxDocument {
  id              String          @id @default(cuid())
  makerspaceId    String
  paymentId       String?
  refundId        String?         @unique
  kind            TaxDocumentKind
  /// "R" for payment documents, "C" for credit notes.
  series          String
  /// "2026-27" in the makerspace's financial year.
  financialYear   String
  sequence        Int
  number          String
  currency        String
  totalMinor      Int
  taxableMinor    Int
  cgstMinor       Int             @default(0)
  sgstMinor       Int             @default(0)
  igstMinor       Int             @default(0)
  otherTaxMinor   Int             @default(0)
  placeOfSupply   String?
  sac             String?
  snapshot        Json
  templateVersion Int             @default(1)
  issuedAt        DateTime        @default(now())
  cancelledAt     DateTime?

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Restrict)
  payment    Payment?   @relation(fields: [makerspaceId, paymentId], references: [makerspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  refund     Refund?    @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([makerspaceId, number])
  @@unique([makerspaceId, series, financialYear, sequence])
  @@index([makerspaceId, issuedAt])
  @@index([paymentId])
}

/// Gapless document numbering per makerspace, series and financial year.
model DocumentCounter {
  makerspaceId  String
  series        String
  financialYear String
  next          Int    @default(1)

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@id([makerspaceId, series, financialYear])
}

/// A makerspace's own outgoing email for customer emails. Without it (or while disabled) customer emails go
/// through the platform's SMTP, sent as the makerspace's name with replies to its contact email. Account
/// emails (password reset, verification) always use the platform's.
model MakerspaceEmailSettings {
  makerspaceId          String    @id
  enabled               Boolean   @default(false)
  fromName              String    @default("")
  fromAddress           String?
  replyTo               String?
  smtpHost              String?
  smtpPort              Int       @default(587)
  /// Implicit TLS (port 465); otherwise STARTTLS is required in production.
  smtpSecure            Boolean   @default(false)
  smtpUser              String?
  smtpPasswordEncrypted String?
  verifiedAt            DateTime?
  updatedAt             DateTime  @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
}

enum ChatChannelKind {
  SLACK
  DISCORD
  MATTERMOST
  TELEGRAM
  WHATSAPP
}

/// A chat destination for team alerts. Webhook URLs, bot tokens and WhatsApp credentials live encrypted in
/// `configEncrypted`; `target` is a safe, non-secret description for the settings page.
model ChatChannel {
  id              String          @id @default(cuid())
  makerspaceId    String
  kind            ChatChannelKind
  name            String
  configEncrypted String
  target          String          @default("")
  events          String[]
  includeNames    Boolean         @default(false)
  enabled         Boolean         @default(true)
  lastDeliveredAt DateTime?
  lastError       String?
  failures        Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@unique([makerspaceId, id])
  @@index([makerspaceId])
}

/// A browser that has signed in to an account before, recognised by a long-lived cookie stored only as a hash.
/// A sign-in from anywhere else needs an emailed code (accounts without an authenticator) and sends an alert.
model KnownDevice {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  label       String   @default("")
  lastIp      String?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, lastSeenAt])
}

// ─── Bookings (Phase 1, docs/BOOKINGS.md) ───────────────────────────────────

enum SpaceKind {
  ROOM
  STUDIO
  DESK
  HALL
  OTHER
}

enum ApprovalMode {
  INSTANT
  APPROVAL
}

enum ChargeMode {
  FREE
  PAY_NOW
  DEPOSIT
  PAY_LATER
}

enum DepositKind {
  PERCENT
  FIXED
}

enum PayLaterDueRule {
  BEFORE_START
  AFTER_BOOKING
}

enum OverdueAction {
  AUTO_CANCEL
  NOTIFY_STAFF
}

enum NoShowCharge {
  FULL
  NONE
}

enum AddOnUnit {
  PER_BOOKING
  PER_HOUR
  PER_PERSON
}

enum RateKind {
  PUBLIC
  MEMBER
}

enum BookingStatus {
  HELD
  REQUESTED
  CONFIRMED
  DECLINED
  EXPIRED
  CANCELLED
}

enum OccurrenceStatus {
  SCHEDULED
  CHECKED_IN
  NO_SHOW
  CANCELLED
  COMPLETED
}

/// PUBLIC = a signed-in customer, GUEST = no account, STAFF = on behalf of a customer, API = an API key (Phase 3).
enum BookingSource {
  PUBLIC
  GUEST
  STAFF
  API
}

enum CancelKind {
  CUSTOMER
  STAFF
  VENUE
  SYSTEM
}

enum CalendarFeedKind {
  CUSTOMER
  STAFF
}

/// Booking rules for the whole makerspace; every field is a rule key of lib/bookingRules/schema.ts and each
/// space may override any of them in `Space.ruleOverrides`. `effectiveRules` is the only reader.
model MakerspaceBookingSettings {
  makerspaceId                  String          @id
  approvalMode                  ApprovalMode    @default(INSTANT)
  requestsBlockSlot             Boolean         @default(true)
  requestExpiryHours            Int             @default(48)
  approvalPayWithinHours        Int             @default(24)
  minDurationMinutes            Int             @default(30)
  maxDurationMinutes            Int             @default(480)
  slotStepMinutes               Int             @default(30)
  leadTimeMinutes               Int             @default(60)
  advanceWindowDays             Int             @default(90)
  bufferBeforeMinutes           Int             @default(0)
  bufferAfterMinutes            Int             @default(0)
  holdMinutes                   Int             @default(15)
  recurrenceMaxOccurrences      Int             @default(52)
  guestBookingAllowed           Boolean         @default(false)
  customerCancelCutoffHours     Int             @default(0)
  customerRescheduleAllowed     Boolean         @default(true)
  customerRescheduleCutoffHours Int             @default(24)
  selfCheckInEnabled            Boolean         @default(false)
  selfCheckInOpensMinutesBefore Int             @default(15)
  selfCheckInClosesMinutesAfter Int             @default(30)
  autoNoShow                    Boolean         @default(false)
  noShowGraceMinutes            Int             @default(30)
  noShowReleasesSlot            Boolean         @default(true)
  noShowCharge                  NoShowCharge    @default(FULL)
  reminderHoursBefore           Int[]           @default([24])
  chargeMode                    ChargeMode      @default(FREE)
  allowPayLater                 Boolean         @default(false)
  depositKind                   DepositKind     @default(PERCENT)
  depositPercentBps             Int             @default(5000)
  depositFixedMinor             Int             @default(0)
  depositRefundable             Boolean         @default(true)
  payLaterDueRule               PayLaterDueRule @default(BEFORE_START)
  payLaterDueHoursBeforeStart   Int             @default(24)
  payLaterDueDaysAfterBooking   Int             @default(7)
  payLaterMinWindowHours        Int             @default(2)
  payLaterMinLeadHours          Int             @default(2)
  overdueAction                 OverdueAction   @default(NOTIFY_STAFF)
  paymentReminderHoursBeforeDue Int[]           @default([24])
  overdueReminderHoursAfterDue  Int[]           @default([24])
  chargeLateCancelWhenUnpaid    Boolean         @default(false)
  updatedAt                     DateTime        @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
}

/// Something bookable inside a makerspace. `units` identical copies (8 hot desks) share one listing.
model Space {
  id                 String    @id @default(cuid())
  makerspaceId       String
  slug               String
  name               String
  kind               SpaceKind @default(ROOM)
  summary            String    @default("")
  /// Markdown, rendered as React text (never HTML).
  description        String    @default("")
  /// People per unit; informational and the attendee limit.
  capacity           Int       @default(1)
  units              Int       @default(1)
  amenities          String[]  @default([])
  /// A design token name, e.g. "teal"; null uses the default.
  colour             String?
  published          Boolean   @default(false)
  archivedAt         DateTime?
  sortOrder          Int       @default(0)
  /// Per-space rule overrides (zod-validated; key present = overridden).
  ruleOverrides      Json      @default("{}")
  /// Rates in minor units; null = not offered. Member null = the public rate; never above it.
  publicHourlyMinor  Int?
  publicHalfDayMinor Int?
  publicDayMinor     Int?
  memberHourlyMinor  Int?
  memberHalfDayMinor Int?
  memberDayMinor     Int?
  halfDayMinutes     Int       @default(240)
  dayMinutes         Int       @default(480)
  /// Tax overrides (need payments.settings); null = the makerspace's.
  taxRateBps         Int?
  sacCode            String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  makerspace      Makerspace          @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  photos          SpacePhoto[]
  openingHours    OpeningHours[]
  hoursExceptions HoursException[]
  blackouts       Blackout[]
  peakRules       PeakRule[]
  addOns          AddOn[]
  refundTiers     RefundTier[]
  bookings        Booking[]
  occurrences     BookingOccurrence[]
  issues          SpaceIssue[]

  @@unique([makerspaceId, slug])
  @@unique([makerspaceId, id])
  @@index([makerspaceId, archivedAt, sortOrder])
}

model SpacePhoto {
  id           String   @id @default(cuid())
  makerspaceId String
  spaceId      String
  url          String
  storageKey   String?
  alt          String   @default("")
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space      @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([spaceId, sortOrder])
}

/// Weekly opening hours. spaceId null = the makerspace default; a space with any rows uses only its own.
/// Weekday 0 = Sunday … 6 = Saturday; minutes from local midnight, close up to 1440 (24:00).
model OpeningHours {
  id           String  @id @default(cuid())
  makerspaceId String
  spaceId      String?
  weekday      Int
  openMinute   Int
  closeMinute  Int

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([makerspaceId, spaceId, weekday])
}

/// A local date with different hours: closed, or special intervals ([{ openMinute, closeMinute }]).
model HoursException {
  id           String   @id @default(cuid())
  makerspaceId String
  spaceId      String?
  date         DateTime @db.Date
  closed       Boolean  @default(true)
  intervals    Json     @default("[]")
  reason       String   @default("")

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([makerspaceId, spaceId, date])
}

/// Closed time. Either whole local days (startDate–endDate, inclusive) or exact instants (startsAt–endsAt).
/// spaceId null = the whole makerspace.
model Blackout {
  id           String    @id @default(cuid())
  makerspaceId String
  spaceId      String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  startsAt     DateTime?
  endsAt       DateTime?
  reason       String    @default("")
  createdAt    DateTime  @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([makerspaceId, spaceId])
}

/// A surcharge on the minutes a booking spends inside a local-time window on the given weekdays.
model PeakRule {
  id           String  @id @default(cuid())
  makerspaceId String
  spaceId      String?
  name         String
  weekdays     Int[]
  startMinute  Int
  endMinute    Int
  surchargeBps Int
  active       Boolean @default(true)

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([makerspaceId, spaceId])
}

/// An extra a booker may add. spaceId null = offered on every space.
model AddOn {
  id               String    @id @default(cuid())
  makerspaceId     String
  spaceId          String?
  name             String
  description      String    @default("")
  unit             AddOnUnit
  priceMinor       Int
  memberPriceMinor Int?
  sacCode          String?
  active           Boolean   @default(true)
  sortOrder        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@unique([makerspaceId, id])
  @@index([makerspaceId, spaceId, active])
}

/// Cancellation policy: the first tier whose minHoursBefore ≤ hours before the start refunds refundBps.
/// spaceId null = the makerspace default; a space with any tiers uses only its own.
model RefundTier {
  id             String  @id @default(cuid())
  makerspaceId   String
  spaceId        String?
  minHoursBefore Int
  refundBps      Int

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space?     @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([makerspaceId, spaceId])
}

/// The member-rate list: a booker whose verified email matches an active, valid row pays member rates.
model MakerspaceMember {
  id           String    @id @default(cuid())
  makerspaceId String
  email        String
  name         String    @default("")
  /// Last local date the member rate applies (inclusive); null = no end.
  validUntil   DateTime? @db.Date
  active       Boolean   @default(true)
  note         String    @default("")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@unique([makerspaceId, email])
}

/// The order: one customer, one space, one or more occurrences. Status changes only via setBookingStatus.
model Booking {
  id                    String         @id @default(cuid())
  makerspaceId          String
  spaceId               String
  /// BK-XXXXXX, unique per makerspace.
  reference             String
  status                BookingStatus  @default(HELD)
  source                BookingSource
  customerUserId        String?
  contactName           String
  contactEmail          String
  contactPhone          String?
  attendees             Int            @default(1)
  /// Identical units booked per slot (one occurrence row each).
  quantity              Int            @default(1)
  purpose               String         @default("")
  internalNotes         String         @default("")
  rateKind              RateKind       @default(PUBLIC)
  chargeMode            ChargeMode     @default(FREE)
  allowPayLater         Boolean        @default(false)
  /// The booking is (or became) pay later: CONFIRMED with paymentDueAt.
  payLater              Boolean        @default(false)
  /// HELD waiting for an upfront payment (Phase 2 settles it with confirmPaidBooking).
  awaitingPayment       Boolean        @default(false)
  currency              String
  subtotalMinor         Int            @default(0)
  taxMinor              Int            @default(0)
  totalMinor            Int            @default(0)
  depositMinor          Int            @default(0)
  /// The current obligation (lib/bookings/obligation.ts), written on every change.
  chargeMinor           Int            @default(0)
  /// Caches maintained by Phase 2 triggers on Payment and Refund.
  paidMinor             Int            @default(0)
  refundedMinor         Int            @default(0)
  paymentDueAt          DateTime?
  overdueAction         OverdueAction?
  /// Frozen price lines, tax snapshot and rates (lib/pricing/quote.ts).
  priceSnapshot         Json           @default("{}")
  /// Frozen cancellation terms: refund tiers, deposit, no-show and late-cancel rules.
  policySnapshot        Json           @default("{}")
  holdExpiresAt         DateTime?
  requestExpiresAt      DateTime?
  submittedAt           DateTime?
  /// sha256 of the manage token; the token itself is only ever emailed or returned once.
  manageTokenHash       String         @unique
  createdById           String?
  overrideReason        String?
  confirmedAt           DateTime?
  approvedAt            DateTime?
  approvedById          String?
  declinedAt            DateTime?
  declinedById          String?
  declineReason         String?
  expiredAt             DateTime?
  cancelledAt           DateTime?
  cancelledById         String?
  cancelKind            CancelKind?
  cancelReason          String?
  writtenOffAt          DateTime?
  writtenOffById        String?
  writtenOffReason      String?
  /// Money the team gave back beyond what was due (manual or provider-dashboard refunds); lowers the charge.
  concessionMinor       Int            @default(0)
  /// Payment reminders sent (lib/bookings/money/jobs.ts): before the due date, and once overdue.
  paymentReminderSentAt DateTime?
  overdueNotifiedAt     DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  makerspace  Makerspace          @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space       Space               @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: NoAction, onUpdate: Cascade)
  customer    User?               @relation(fields: [customerUserId], references: [id], onDelete: SetNull)
  occurrences BookingOccurrence[]
  events      BookingEvent[]
  payments    Payment[]

  @@unique([makerspaceId, reference])
  @@unique([makerspaceId, id])
  @@unique([id, spaceId])
  @@index([makerspaceId, status, createdAt])
  @@index([status, holdExpiresAt])
  @@index([status, requestExpiresAt])
  @@index([customerUserId])
  @@index([makerspaceId, contactEmail])
}

/// One slot of one unit. Blocking rows can never overlap per (space, unit): see the exclusion constraint.
model BookingOccurrence {
  id             String           @id @default(cuid())
  makerspaceId   String
  bookingId      String
  spaceId        String
  /// Which slot of the series (0-based); quantity > 1 gives several rows per slot.
  slotIndex      Int
  unit           Int
  startsAt       DateTime         @db.Timestamptz(3)
  endsAt         DateTime         @db.Timestamptz(3)
  /// startsAt − buffer before and endsAt + buffer after (timestamptz for the tstzrange exclusion constraint).
  blockStart     DateTime         @db.Timestamptz(3)
  blockEnd       DateTime         @db.Timestamptz(3)
  blocking       Boolean          @default(false)
  status         OccurrenceStatus @default(SCHEDULED)
  rateKind       RateKind         @default(PUBLIC)
  /// This row's share of the booking total (largest remainder, tax included).
  priceMinor     Int              @default(0)
  /// What the customer still owes for this row after it was cancelled or shortened.
  keptFeeMinor   Int              @default(0)
  /// The earliest start this slot ever had: cancellation tiers count from here.
  policyAnchorAt DateTime
  /// ICS SEQUENCE, bumped on every reschedule or cancel.
  sequence       Int              @default(0)
  cancelledAt    DateTime?
  cancelKind     CancelKind?
  checkedInAt    DateTime?
  checkedInById  String?
  noShowAt       DateTime?
  noShowById     String?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  booking   Booking       @relation(fields: [bookingId, spaceId], references: [id, spaceId], onDelete: Cascade, onUpdate: Cascade)
  space     Space         @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: NoAction)
  reminders ReminderLog[]

  @@unique([makerspaceId, id])
  @@index([bookingId, slotIndex])
  @@index([spaceId, unit, blockStart])
  @@index([makerspaceId, startsAt])
  @@index([status, blockEnd])
  @@index([status, startsAt])
}

/// The booking timeline. Append-only (a trigger forbids UPDATE and DELETE).
model BookingEvent {
  id           String   @id @default(cuid())
  makerspaceId String
  bookingId    String
  occurrenceId String?
  kind         String
  /// CUSTOMER, STAFF, SYSTEM or API.
  actorKind    String
  actorUserId  String?
  data         Json     @default("{}")
  createdAt    DateTime @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  booking    Booking    @relation(fields: [makerspaceId, bookingId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@index([makerspaceId, createdAt])
}

/// One reminder per occurrence, kind and start: a reschedule (new start) may remind again.
model ReminderLog {
  id           String   @id @default(cuid())
  makerspaceId String
  occurrenceId String
  kind         String
  startsAt     DateTime
  sentAt       DateTime @default(now())

  occurrence BookingOccurrence @relation(fields: [makerspaceId, occurrenceId], references: [makerspaceId, id], onDelete: Cascade)

  @@unique([occurrenceId, kind, startsAt])
}

/// A private ICS subscription: a customer's own bookings or (staff) the whole makerspace. Token hash only.
model CalendarFeed {
  id           String           @id @default(cuid())
  makerspaceId String
  kind         CalendarFeedKind
  userId       String
  tokenHash    String           @unique
  /// Last characters of the token, to tell feeds apart in the UI.
  tokenHint    String
  createdAt    DateTime         @default(now())
  rotatedAt    DateTime?
  revokedAt    DateTime?

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([makerspaceId, userId, kind])
}

/// A makerspace's REST API key (`/api/v1`). Only the hash of the secret is stored; the full key is shown once.
model ApiKey {
  id           String    @id @default(cuid())
  makerspaceId String
  name         String
  /// Shown in the UI and the first part of the key, e.g. swb_k7m2q9xa.
  prefix       String    @unique
  secretHash   String
  /// "read" and/or "write".
  scopes       String[]
  createdById  String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)

  @@index([makerspaceId, revokedAt])
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

/// An outbound webhook subscription (lib/integrations/webhooks). The signing secret is encrypted at rest.
model WebhookEndpoint {
  id                  String    @id @default(cuid())
  makerspaceId        String
  url                 String
  description         String    @default("")
  events              String[]
  secretEncrypted     String
  isActive            Boolean   @default(true)
  consecutiveFailures Int       @default(0)
  disabledAt          DateTime?
  createdById         String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  makerspace Makerspace        @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([makerspaceId, id])
  @@index([makerspaceId, isActive])
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  makerspaceId   String
  endpointId     String
  event          String
  /// The source of the event (a BookingEvent id, or `ping-…`); unique per endpoint so a relay never sends twice.
  eventId        String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?
  lastError      String                @default("")
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())

  endpoint WebhookEndpoint @relation(fields: [makerspaceId, endpointId], references: [makerspaceId, id], onDelete: Cascade)

  @@unique([endpointId, eventId])
  @@index([makerspaceId, endpointId, createdAt])
  @@index([status, nextAttemptAt])
}

/// Where the webhook relay got to in the BookingEvent stream (one row, id "booking-events").
model WebhookRelayCursor {
  id        String   @id
  createdAt DateTime
  eventId   String
}

// ── Repairs and the finance ledger (0006_repairs_finance; docs/DECISIONS.md, owner decisions 2026-10-24) ──

enum IssueSeverity {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// REPORTED → ASSIGNED (a technician accepted or was assigned) → FIXED (by the technician) → CLOSED (verified by a
/// bookings manager); a manager may reopen a FIXED or CLOSED issue to ASSIGNED with a reason.
enum IssueStatus {
  REPORTED
  ASSIGNED
  FIXED
  CLOSED
}

enum TechnicianKind {
  STAFF
  EXTERNAL
}

enum TechnicianChannel {
  EMAIL
  WHATSAPP
  TELEGRAM
}

enum RepairRequestStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CLOSED
}

enum PayoutMethod {
  CASH
  BANK_TRANSFER
  UPI
  OTHER
}

enum FinanceDirection {
  IN
  OUT
}

enum FinanceMethod {
  GATEWAY_RAZORPAY
  GATEWAY_STRIPE
  CASH
  BANK_TRANSFER
  UPI
  OTHER
}

enum FinanceCategory {
  BOOKING_PAYMENT
  OTHER_PAYMENT
  REFUND
  REPAIR_PAYOUT
  RENT
  UTILITIES
  SUPPLIES
  STAFF_COSTS
  OTHER_INCOME
  OTHER_EXPENSE
}

/// Someone a makerspace can ask to fix things: a team member with the TECHNICIAN role, or an outside contact.
model Technician {
  id               String            @id @default(cuid())
  makerspaceId     String
  kind             TechnicianKind
  /// STAFF only: the team member this entry is for.
  userId           String?
  name             String
  email            String?
  phone            String?
  whatsapp         String?
  telegramChatId   String?
  skills           String[]          @default([])
  preferredChannel TechnicianChannel @default(EMAIL)
  notes            String            @default("")
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  makerspace Makerspace      @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  issues     SpaceIssue[]
  requests   RepairRequest[]
  payouts    RepairPayout[]

  @@unique([makerspaceId, id])
  @@unique([makerspaceId, userId])
  @@index([makerspaceId, active])
}

/// Something wrong with a space (the AC, the projector, the lights…), from report to paid repair.
model SpaceIssue {
  id               String        @id @default(cuid())
  makerspaceId     String
  spaceId          String
  reference        String
  title            String
  description      String        @default("")
  severity         IssueSeverity @default(MEDIUM)
  status           IssueStatus   @default(REPORTED)
  /// STAFF or CUSTOMER.
  reporterKind     String
  reportedById     String?
  bookingId        String?
  technicianId     String?
  assignedAt       DateTime?
  fixRemarks       String        @default("")
  partsUsed        String        @default("")
  /// What the technician asks for the work, in `currency`.
  amountAskedMinor Int?
  currency         String
  fixedAt          DateTime?
  /// What a bookings manager agreed to pay; payouts never exceed it.
  approvedMinor    Int?
  approvedById     String?
  approvalNote     String        @default("")
  closedAt         DateTime?
  closedById       String?
  /// The blackout keeping the space unbookable while it is out of service (removed when the issue closes).
  blackoutId       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  makerspace Makerspace      @relation(fields: [makerspaceId], references: [id], onDelete: Cascade)
  space      Space           @relation(fields: [makerspaceId, spaceId], references: [makerspaceId, id], onDelete: Cascade)
  technician Technician?     @relation(fields: [makerspaceId, technicianId], references: [makerspaceId, id], onDelete: Restrict)
  photos     IssuePhoto[]
  requests   RepairRequest[]
  events     IssueEvent[]
  payouts    RepairPayout[]

  @@unique([makerspaceId, id])
  @@unique([makerspaceId, reference])
  @@index([makerspaceId, status, createdAt])
  @@index([makerspaceId, spaceId])
}

model IssuePhoto {
  id           String   @id @default(cuid())
  makerspaceId String
  issueId      String
  url          String
  storageKey   String
  /// STAFF, CUSTOMER or TECHNICIAN.
  addedBy      String
  createdAt    DateTime @default(now())

  issue SpaceIssue @relation(fields: [makerspaceId, issueId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

/// One technician asked to take one issue. External technicians answer through a link (SHA-256 of the token here).
model RepairRequest {
  id           String              @id @default(cuid())
  makerspaceId String
  issueId      String
  technicianId String
  status       RepairRequestStatus @default(SENT)
  channels     String[]            @default([])
  tokenHash    String?             @unique
  expiresAt    DateTime
  sentById     String?
  sentAt       DateTime            @default(now())
  answeredAt   DateTime?

  issue      SpaceIssue @relation(fields: [makerspaceId, issueId], references: [makerspaceId, id], onDelete: Cascade)
  technician Technician @relation(fields: [makerspaceId, technicianId], references: [makerspaceId, id], onDelete: Cascade)

  @@unique([makerspaceId, id])
  @@unique([issueId, technicianId])
  @@index([status, expiresAt])
}

/// The issue's timeline (append-only); also the source of the issue webhooks.
model IssueEvent {
  id           String   @id @default(cuid())
  makerspaceId String
  issueId      String
  kind         String
  /// STAFF, CUSTOMER, TECHNICIAN (through a link) or SYSTEM.
  actorKind    String
  actorUserId  String?
  technicianId String?
  data         Json     @default("{}")
  createdAt    DateTime @default(now())

  issue SpaceIssue @relation(fields: [makerspaceId, issueId], references: [makerspaceId, id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([makerspaceId, createdAt])
}

/// Money paid to a technician for an issue. Append-only (trigger); each row posts one FinanceEntry.
model RepairPayout {
  id           String       @id @default(cuid())
  makerspaceId String
  issueId      String
  technicianId String?
  amountMinor  Int
  currency     String
  method       PayoutMethod
  reference    String?
  note         String       @default("")
  paidAt       DateTime
  paidById     String
  createdAt    DateTime     @default(now())

  issue      SpaceIssue  @relation(fields: [makerspaceId, issueId], references: [makerspaceId, id], onDelete: Restrict)
  technician Technician? @relation(fields: [makerspaceId, technicianId], references: [makerspaceId, id], onDelete: Restrict)

  @@index([makerspaceId, paidAt])
  @@index([issueId])
}

/// Every money movement, append-only (trigger), posted in its source's own transaction: settled payments, processed
/// refunds and repair payouts by trigger, manual entries and reversals by lib/finance/ledger.ts. A source posts once
/// (`sourceType` + `sourceId` unique).
model FinanceEntry {
  id           String           @id
  makerspaceId String
  direction    FinanceDirection
  category     FinanceCategory
  amountMinor  Int
  currency     String
  method       FinanceMethod
  reference    String?
  occurredAt   DateTime
  /// PAYMENT, REFUND, REPAIR_PAYOUT, MANUAL or REVERSAL.
  sourceType   String
  sourceId     String
  actorUserId  String?
  note         String           @default("")
  spaceId      String?
  bookingId    String?
  issueId      String?
  technicianId String?
  /// REVERSAL only: the entry this one cancels out.
  reversesId   String?          @unique
  createdAt    DateTime         @default(now())

  makerspace Makerspace @relation(fields: [makerspaceId], references: [id], onDelete: Restrict)

  @@unique([sourceType, sourceId])
  @@index([makerspaceId, occurredAt])
}
