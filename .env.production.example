# Production settings, read by scripts/spaceworks-compose.sh. Every value is a placeholder.
#   bundled  the curl installer / setup.sh writes the install's .env for you (owner-only).
#            This file documents it; edit that .env only to change a setting, then run
#            scripts/spaceworks-compose.sh bundled up -d.
#   cloud    copy this file to /etc/spaceworks-bookings/cloud.env (chmod 600), fill it,
#            then run scripts/spaceworks-compose.sh cloud up -d. See docs/DEPLOYMENT_CLOUD.md.
# Every variable is described in docs/CONFIGURATION.md. Single quotes keep values literal.

# --- Release and layout (bundled) ---
SWB_REPOSITORY='SpaceWorks-Labs/SpaceWorks-Bookings'
SWB_BACKEND_IMAGE='ghcr.io/spaceworks-labs/spaceworks-bookings-backend'
SWB_FRONTEND_IMAGE='ghcr.io/spaceworks-labs/spaceworks-bookings-frontend'
# none = plain HTTP through Caddy; tls = automatic HTTPS (Let's Encrypt); proxy = your own proxy on 127.0.0.1:8080
SWB_LAYER='none'
# bundled = Silo on this server; external = the S3_* bucket below
SWB_STORAGE='bundled'

# --- Public address ---
PUBLIC_APP_BASE_URL='https://book.example.org'
# Caddy's site: the domain for automatic HTTPS, or http://<host> for plain HTTP.
SITE_ADDRESS='book.example.org'
TLS_EMAIL='ops@example.org'
HTTP_PORT='80'
# Only for a LAN or trial install on plain HTTP.
# ALLOW_PLAIN_HTTP='1'
# Backend for a Netlify website (docs/DEPLOYMENT_NETLIFY.md): DEPLOYMENT_MODE='backend' and a 64-hex secret.
# DEPLOYMENT_MODE='backend'
# FRONTEND_GATEWAY_SECRET='replace-with-openssl-rand-hex-32'

# --- Bundled data services (generated by setup.sh; alphanumeric) ---
POSTGRES_PASSWORD='replace-with-a-long-random-alphanumeric'
POSTGRES_APP_PASSWORD='replace-with-another-long-random-alphanumeric'
REDIS_PASSWORD='replace-with-a-long-random-alphanumeric'
MINIO_ROOT_USER='swbook-root'
MINIO_ROOT_PASSWORD='replace-with-a-long-random-alphanumeric'
S3_APP_PASSWORD='replace-with-a-long-random-alphanumeric'
# Scheduled backups into backups/ (database dump and bucket mirror).
BACKUP_INTERVAL_HOURS='24'
BACKUP_RETENTION_DAYS='14'

# --- Managed services (cloud; or an external bucket with SWB_STORAGE='external') ---
DATABASE_URL='postgresql://user:password@db.example.org:6543/postgres?sslmode=require&pgbouncer=true'
DIRECT_URL='postgresql://user:password@db.example.org:5432/postgres?sslmode=require'
# Only when the provider's URL names no sslmode (Render's managed PostgreSQL): the entrypoint adds it.
# DATABASE_URL_SSLMODE='require'
REDIS_URL='rediss://default:password@redis.example.org:6379'
S3_ENDPOINT='https://account-id.r2.cloudflarestorage.com'
S3_REGION='auto'
S3_BUCKET='spaceworks-bookings'
S3_ACCESS_KEY_ID='replace-with-the-bucket-access-key'
S3_SECRET_ACCESS_KEY='replace-with-the-bucket-secret-key'
S3_FORCE_PATH_STYLE='1'
# Cloud only: the header your platform's edge overwrites with the client address.
TRUSTED_PROXY_IP_HEADER='x-forwarded-for'
# With x-forwarded-for: how many trusted proxies append to it.
# TRUSTED_PROXY_HOPS='1'
APP_BIND='127.0.0.1'
APP_PORT='8080'

# --- Application secrets (generated by setup.sh) ---
AUTH_SECRET='replace-with-openssl-rand-base64-48'
CRON_SECRET='replace-with-openssl-rand-base64-48'
HEALTHCHECK_SECRET='replace-with-openssl-rand-base64-48'
# Base64 of exactly 32 random bytes each (openssl rand -base64 32); never change them once in use.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='
MFA_ENCRYPTION_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='
PAYMENT_SECRETS_KEY='MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY='

# --- People and email ---
SUPER_ADMIN_EMAIL='admin@example.org'
# Check new passwords against known breaches (only a 5-character hash prefix leaves the server); 0 turns it off.
PWNED_PASSWORDS_CHECK='1'
EMAIL_FROM='Space Works Bookings <noreply@example.org>'
SMTP_HOST='smtp-relay.brevo.com'
SMTP_PORT='587'
SMTP_SECURE='false'
SMTP_USER='replace-with-the-smtp-login'
SMTP_PASSWORD='replace-with-the-smtp-key'

# --- Background jobs (BullMQ worker and beat; defaults shown) ---
# JOBS_QUEUE_PREFIX='swb:jobs'
# JOBS_HEALTH_PORT='3460'
# QUEUE_OUTBOX_CONCURRENCY='5'
# QUEUE_SCHEDULED_CONCURRENCY='2'
# Development only; ignored in production.
# JOBS_INPROCESS='false'

# Days to keep delivered outbox rows.
# OUTBOX_RETENTION_DAYS='30'

# --- Platforms without the Compose wrapper (render.yaml, .do/app.yaml, your own) ---
# The Compose files set these from PUBLIC_APP_BASE_URL; elsewhere set them directly, to the same origin.
# NODE_ENV='production'
# AUTH_URL='https://book.example.org'
# NEXT_PUBLIC_BASE_URL='https://book.example.org'
# Apply migrations before the web server starts, where there is no separate release step.
# MIGRATE_ON_START='1'

# --- Optional ---
# NEXT_PUBLIC_HOSTED_BY='Your makerspace'
