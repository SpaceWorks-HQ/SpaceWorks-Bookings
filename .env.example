# Copy to .env and adjust. Local Postgres and Redis via: docker compose up -d

DATABASE_URL="postgresql://swbook:swbook_dev@localhost:5432/swbook_dev"
# Direct (non-pooled) connection used only by Prisma migrations. Locally it is the
# same database; behind a transaction pooler it bypasses the pooler.
# The `npm run db:*` scripts fall back to DATABASE_URL when this is unset.
DIRECT_URL="postgresql://swbook:swbook_dev@localhost:5432/swbook_dev"

# Redis (rate limits and the BullMQ job queues). Required in production, where it must use TLS (rediss://).
# Locally, leave it set and run `npm run build:jobs`, then `npm run worker` and `npm run beat`.
REDIS_URL="redis://localhost:6379"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# For localhost-only development, set this to http://localhost:3000. Set both in production.
# AUTH_URL="http://localhost:3000"
# Canonical origin used in generated links (receipts, cards, emails). In production it must
# exactly match AUTH_URL, including the HTTPS scheme.
# NEXT_PUBLIC_BASE_URL="http://localhost:3000"
# Shown in the site footer as "Hosted by …". Leave empty to hide it.
# NEXT_PUBLIC_HOSTED_BY="Shaan Shoukath, Systems Engineer"

# Production only: 1 allows an http:// AUTH_URL/NEXT_PUBLIC_BASE_URL (LAN or trial install).
# ALLOW_PLAIN_HTTP="0"

# Comma-separated trusted CDN/reverse-proxy hostnames allowed to invoke Server Actions.
ALLOWED_ACTION_ORIGINS=""
# Select only a header your edge proxy overwrites. Cloudflare users keep this default.
TRUSTED_PROXY_IP_HEADER="cf-connecting-ip"

# Comma-separated hosts allowed to request dev assets, for example a LAN IP.
# NEXT_DEV_ALLOWED_ORIGINS="192.168.1.6"

# Email fallback. Prefer Super admin → Settings; values saved there win.
EMAIL_FROM="Space Works Bookings <noreply@localhost>"
SMTP_SERVICE=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
# Set to 1 only for an intentionally unauthenticated private SMTP relay.
SMTP_ALLOW_UNAUTHENTICATED="0"

# Bearer secret for the external cron triggers POST /api/internal/outbox and /api/internal/jobs, which only
# enqueue work for the worker (generate: openssl rand -base64 32).
CRON_SECRET=""
# Background jobs (BullMQ). The prefix keeps installs and test runs apart in one Redis.
JOBS_QUEUE_PREFIX="swb:jobs"
# Port of the worker's and beat's own /health endpoint.
JOBS_HEALTH_PORT="3460"
# Parallel jobs per queue in the worker (1 to 64).
QUEUE_OUTBOX_CONCURRENCY="5"
QUEUE_SCHEDULED_CONCURRENCY="2"
# Development only, with REDIS_URL unset: run every job inside `npm run dev` once a minute.
JOBS_INPROCESS="false"
OUTBOX_RETENTION_DAYS="30"
# Readiness probe secret for GET /api/health/db.
HEALTHCHECK_SECRET=""

# Valid base64 for a 16, 24 or 32-byte AES key. Stable across every container serving one build.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""
# Independent 32-byte AES key for authenticator seeds at rest.
MFA_ENCRYPTION_KEY=""
# Independent 32-byte AES-GCM key (base64) for payment gateway secrets at rest. Back it up:
# without it, saved Razorpay/Stripe keys cannot be read. Generate: openssl rand -base64 32
PAYMENT_SECRETS_KEY=""

# Private S3-compatible object storage (Silo on a VPS; R2 or any S3 in the cloud).
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="0"

# The first super admin. The installer creates it with a password; super admins are managed only on the
# server (bash scripts/admin.sh), never by email or in the app.
SUPER_ADMIN_EMAIL=""

# New passwords are checked against known breaches (Have I Been Pwned, k-anonymity: only a 5-character hash
# prefix leaves the server). Set to 0 on installs without internet access.
PWNED_PASSWORDS_CHECK="1"

# Backup posture fallback shown in Super admin → Settings.
BACKUP_PROVIDER=""
BACKUP_LAST_SUCCESS_AT=""
BACKUP_RETENTION_DAYS="30"

# Optional split hosting (frontend on Netlify, backend on a VPS). Leave unset for one container.
# Backend: DEPLOYMENT_MODE=backend; an independent 32-byte random hex gateway key.
# DEPLOYMENT_MODE="backend"
FRONTEND_GATEWAY_SECRET=""
# Frontend only: canonical backend origin (no path or trailing slash).
BACKEND_ORIGIN=""
NEXT_PUBLIC_BACKEND_ORIGIN=""
# Netlify: x-nf-client-connection-ip. Your own trusted proxy: x-real-ip.
FRONTEND_TRUSTED_IP_HEADER=""
